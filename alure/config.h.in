/* Define if we have wave file support */
#define HAVE_WAVE 1

/* Define if we have vorbisfile support */
#cmakedefine HAVE_VORBISFILE

/* Define if we have FLAC support */
#define HAVE_FLAC 1

/* Define if we have opusfile support */
#cmakedefine HAVE_OPUSFILE

/* Define if we have libsndfile support */
#cmakedefine HAVE_LIBSNDFILE

/* Define if we have MINIMP3 support */
#define HAVE_MINIMP3 1
