# Copy to .env. Do not commit .env.

BITFIGHTER_HOSTNAME=VPS one
BITFIGHTER_HOSTNAME_2=VPS two
BITFIGHTER_HOSTNAME_3=VPS three
BITFIGHTER_HOSTDESCR=

# Players need the server password. Owner and admin should not be empty,
# or anyone on the server can claim those roles.
BITFIGHTER_SERVER_PASSWORD=
BITFIGHTER_ADMIN_PASSWORD=
BITFIGHTER_OWNER_PASSWORD=
BITFIGHTER_LEVEL_CHANGE_PASSWORD=

# Empty uses the engine default (128).
BITFIGHTER_MAX_PLAYERS=

# 1 announces to BITFIGHTER_MASTER. 0 points -master at 127.0.0.1:9.
BITFIGHTER_REGISTER_MASTER=1
BITFIGHTER_MASTER=IP:107.172.71.173:25955
