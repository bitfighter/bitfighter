# Copy to .env and fill in. Do not commit .env.

# Image tag. Public servers should stay on 022 (protocol 41).
BITFIGHTER_RELEASE=022

# Host UDP port published to 28000/udp in the container.
BITFIGHTER_PORT=28000

BITFIGHTER_HOSTNAME=Bitfighter
BITFIGHTER_HOSTDESCR=

# Set these. Empty owner/admin passwords mean anyone can claim those roles.
BITFIGHTER_OWNER_PASSWORD=
BITFIGHTER_ADMIN_PASSWORD=

# Leave empty for the engine default (128).
BITFIGHTER_MAX_PLAYERS=

# Used only with: docker compose --profile 023 up
BITFIGHTER_HOSTNAME_023=Bitfighter 023
BITFIGHTER_HOSTDESCR_023=
